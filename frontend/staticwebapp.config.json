{
  "routes": [
    { "route": "/backoffice", "rewrite": "/workspace.html" },
    { "route": "/api/setup/*", "allowedRoles": ["anonymous"] },
    { "route": "/api/updater/*", "allowedRoles": ["anonymous"] },
    { "route": "/api/health", "allowedRoles": ["anonymous"] },
    { "route": "/api/contact", "allowedRoles": ["anonymous"] },
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/.auth/login/github", "statusCode": 404 }
  ],
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/api/*", "/.auth/*", "/*.{css,js,svg,png,ico}"] },
  "platform": { "apiRuntime": "python:3.11" },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
  }
}
